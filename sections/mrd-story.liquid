{% comment %}
  MERIDIAN — Storytelling maison (sections/mrd-story.liquid)
  Section indépendante, plaçable sur n'importe quel template via le customizer.
  Image + eyebrow + titre serif + texte riche + lien fileté.
  Variante : image à gauche ou à droite (setting), fond noir ou surface.
  Autonome : CSS scopé .mrd-st, JS vanilla minimal, aucun asset externe.
{% endcomment %}

{% style %}
  .mrd-st{
    --mrd-noir:#0B0B0D;
    --mrd-surface:#101013;
    --mrd-creme:#F2EDE4;
    --mrd-gris:#9B968C;
    --mrd-or:#C8A35F;
    --mrd-grad-or:linear-gradient(135deg,#E7CF94 0%,#C8A35F 45%,#9C7B3E 100%);
    --mrd-ligne:rgba(242,237,228,.08);
    --mrd-focus:0 0 0 2px #0B0B0D,0 0 0 4px #C8A35F;
    --mrd-ease-out:cubic-bezier(.22,1,.36,1);
    --mrd-ease-inout:cubic-bezier(.65,0,.35,1);
    background:var(--mrd-noir);
    color:var(--mrd-creme);
    font-family:'Inter',sans-serif;
    font-weight:300;
    font-size:1.0625rem;
    line-height:1.7;
    overflow:clip;
    -webkit-font-smoothing:antialiased;
  }
  .mrd-st.mrd-st-fond-surface{background:var(--mrd-surface);border-top:1px solid var(--mrd-ligne);border-bottom:1px solid var(--mrd-ligne)}
  .mrd-st *,.mrd-st *::before,.mrd-st *::after{box-sizing:border-box;margin:0;padding:0}
  .mrd-st img,.mrd-st svg{display:block;max-width:100%}
  .mrd-st h2{font-family:'Cormorant Garamond',serif;font-weight:500;font-size:clamp(1.9rem,3.6vw,2.9rem);line-height:1.12;color:var(--mrd-creme)}
  .mrd-st a{color:inherit}
  .mrd-st a:focus-visible{outline:none;box-shadow:var(--mrd-focus)}
  .mrd-st .mrd-st-wrap{max-width:1320px;margin:0 auto;padding:clamp(4rem,10vh,7rem) clamp(1.25rem,5vw,4rem)}
  .mrd-st .mrd-st-duo{display:grid;grid-template-columns:1fr;gap:clamp(2.5rem,6vw,5rem);align-items:center}
  .mrd-st .mrd-st-figure{position:relative;overflow:hidden;aspect-ratio:4/5;border:1px solid var(--mrd-ligne)}
  .mrd-st .mrd-st-figure img,.mrd-st .mrd-st-figure svg{width:100%;height:100%;object-fit:cover}
  .mrd-st .mrd-st-eyebrow{font-weight:500;font-size:.72rem;letter-spacing:.35em;text-transform:uppercase;color:var(--mrd-or);margin-bottom:1.25rem}
  .mrd-st .mrd-st-rule{display:block;width:48px;height:1px;background:var(--mrd-grad-or);margin-top:1.75rem}
  .mrd-st .mrd-st-texte{color:var(--mrd-gris);max-width:560px;margin-top:1.5rem}
  .mrd-st .mrd-st-texte p+p{margin-top:1rem}
  .mrd-st .mrd-st-link{position:relative;display:inline-block;margin-top:1.75rem;padding:.85rem 0;color:var(--mrd-creme);font-weight:400;font-size:.72rem;letter-spacing:.3em;text-transform:uppercase;text-decoration:none}
  .mrd-st .mrd-st-link::after{content:"";position:absolute;left:0;bottom:.5rem;width:100%;height:1px;background:var(--mrd-or);transform:scaleX(.35);transform-origin:left;transition:transform .3s var(--mrd-ease-inout)}
  .mrd-st .mrd-st-link:hover::after{transform:scaleX(1)}
  @media(min-width:900px){
    .mrd-st .mrd-st-duo{grid-template-columns:1fr 1.05fr}
    .mrd-st.mrd-st-image-droite .mrd-st-figure{order:2}
  }

  /* Révélations (contrat MERIDIAN Motion : .mrd-reveal → .mrd-in) */
  .mrd-st .mrd-reveal{opacity:0;transform:translateY(24px);transition:opacity .9s var(--mrd-ease-out),transform .9s var(--mrd-ease-out);transition-delay:var(--mrd-d,0ms)}
  .mrd-st .mrd-reveal.mrd-in{opacity:1;transform:none}

  @media(prefers-reduced-motion:reduce){
    .mrd-st *,.mrd-st *::before,.mrd-st *::after{animation:none!important;transition:none!important}
    .mrd-st .mrd-reveal{opacity:1!important;transform:none!important}
  }
{% endstyle %}

<div class="mrd-st{% if section.settings.image_position == 'droite' %} mrd-st-image-droite{% endif %}{% if section.settings.fond == 'surface' %} mrd-st-fond-surface{% endif %}" data-mrd-st>
  <section class="mrd-st-wrap" aria-labelledby="mrd-st-title-{{ section.id }}">
    <div class="mrd-st-duo">
      <figure class="mrd-st-figure mrd-reveal">
        {%- if section.settings.image -%}
          {{ section.settings.image
             | image_url: width: 1200
             | image_tag: loading: 'lazy', decoding: 'async', widths: '400, 600, 800, 1200', alt: section.settings.image.alt | default: section.settings.titre }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag }}
        {%- endif -%}
      </figure>
      <div class="mrd-reveal" style="--mrd-d:150ms">
        {%- if section.settings.eyebrow != blank -%}
          <p class="mrd-st-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 id="mrd-st-title-{{ section.id }}">{{ section.settings.titre }}</h2>
        <span class="mrd-st-rule" aria-hidden="true"></span>
        <div class="mrd-st-texte">{{ section.settings.texte }}</div>
        {%- if section.settings.lien != blank and section.settings.lien_libelle != blank -%}
          <a class="mrd-st-link" href="{{ section.settings.lien }}">{{ section.settings.lien_libelle }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

<script>
(function(){
  'use strict';
  var reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function initRoot(root){
    if(root.dataset.mrdInit)return;
    root.dataset.mrdInit='1';
    /* Révélations : le moteur global MERIDIAN Motion gère .mrd-reveal
       s'il est présent ; cet observateur scopé sert de garantie. */
    var toReveal=Array.prototype.slice.call(root.querySelectorAll('.mrd-reveal'));
    if(reduced||!('IntersectionObserver' in window)){
      toReveal.forEach(function(el){el.classList.add('mrd-in');});
      return;
    }
    var io=new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){e.target.classList.add('mrd-in');io.unobserve(e.target);}
      });
    },{threshold:.15,rootMargin:'0px 0px -8% 0px'});
    toReveal.forEach(function(el){io.observe(el);});
  }

  function initAll(){
    Array.prototype.slice.call(document.querySelectorAll('.mrd-st[data-mrd-st]')).forEach(initRoot);
  }
  initAll();
  document.addEventListener('shopify:section:load',initAll);
})();
</script>

{% schema %}
{
  "name": "MERIDIAN — Storytelling",
  "tag": "section",
  "class": "mrd-section-story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Position de l'image",
      "options": [
        { "value": "gauche", "label": "Image à gauche" },
        { "value": "droite", "label": "Image à droite" }
      ],
      "default": "gauche"
    },
    {
      "type": "select",
      "id": "fond",
      "label": "Fond",
      "options": [
        { "value": "noir", "label": "Noir profond" },
        { "value": "surface", "label": "Surface (légèrement contrasté)" }
      ],
      "default": "noir"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sur-titre",
      "default": "La maison"
    },
    {
      "type": "text",
      "id": "titre",
      "label": "Titre",
      "default": "Une maison, un méridien"
    },
    {
      "type": "richtext",
      "id": "texte",
      "label": "Texte",
      "default": "<p>Meridian est née d'une conviction : le canapé n'est pas un meuble parmi d'autres. C'est le centre de gravité d'une maison — là où les journées se terminent et où les conversations commencent.</p><p>Chaque pièce est dessinée pour durer, tapissée à la commande, livrée en gants blancs. Rien de plus, rien de moins.</p>"
    },
    {
      "type": "url",
      "id": "lien",
      "label": "Lien (facultatif)"
    },
    {
      "type": "text",
      "id": "lien_libelle",
      "label": "Libellé du lien",
      "default": "Découvrir la maison"
    }
  ],
  "presets": [
    {
      "name": "MERIDIAN — Storytelling"
    }
  ]
}
{% endschema %}
